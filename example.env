# Developer settings for Bao Internal Apps.
# Copy this file to .env and change only what you need; everything here is the default.
# LEARN: every key starts with BAO_ and maps to one field of the app settings
# class (BAO_LOG_LEVEL fills log_level). Without a .env the defaults apply.

# Window size the first time the app opens (later it reopens where you left it)
BAO_DEFAULT_WINDOW_WIDTH=1000
BAO_DEFAULT_WINDOW_HEIGHT=680

# Smallest size the window can be resized to
BAO_MIN_WINDOW_WIDTH=720
BAO_MIN_WINDOW_HEIGHT=480

# DEBUG, INFO, WARNING or ERROR
BAO_LOG_LEVEL=INFO

# Log folder, relative to the project folder or absolute
BAO_LOG_DIR=logs
